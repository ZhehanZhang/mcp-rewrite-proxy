{
  "name": "mcp-rewrite-proxy",
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild src/server.ts src/cli.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --out-extension:.js=.mjs --loader:.html=text",
    "start": "node dist/server.mjs",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "node test/e2e.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "private": true
}
