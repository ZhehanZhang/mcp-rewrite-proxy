# Copy to .env on every node. Values must be identical across nodes.

# The tunnel's public hostname. Every OAuth URL the proxy publishes is built from it.
PUBLIC_URL=https://mcp-proxy.example.com
# The upstream MCP endpoint (Streamable HTTP).
UPSTREAM_URL=https://mcp.example.com/mcp

# Cloudflare Tunnel connector token (Zero Trust → Networks → Tunnels → your tunnel). Same on every node.
# In the tunnel's public hostname, set the service to http://localhost:8080.
TUNNEL_TOKEN=

# Secrets. Each can instead be read from a file, e.g. ADMIN_PASSWORD_FILE=/run/secrets/admin_password.
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -hex 32`. Must match on every node: it signs and
# encrypts everything agents are issued, so any node can verify what another node issued.
PROXY_SECRET=
# When rotating PROXY_SECRET, put the old value here until agents' tokens have renewed (≤ 30 days).
# PROXY_SECRET_PREVIOUS=

# Optional
# PROXY_NAME=MCP Rewrite Proxy
# UPSTREAM_SCOPES=read write
# UPSTREAM_CLIENT_ID=
# UPSTREAM_CLIENT_SECRET=
# UPSTREAM_SEND_RESOURCE=false
# UPSTREAM_AUTH_SERVER_OVERRIDES={"registration_endpoint":"https://…"}
# API_KEYS=key-one-at-least-16-chars,key-two-at-least-16-chars
